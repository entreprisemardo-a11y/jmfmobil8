# ============================================================================
# Configuration SEO & Routage SPA pour JMF Mobility Services (Asura Hosting)
# Domaine officiel : https://jmfmobilityservices.com/
# Compatible Apache / LiteSpeed Web Server (cPanel Asura Hosting)
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Consolidation SEO des Backlinks : Forcer HTTPS et rediriger www -> sans www en 301
  # Cela garantit que 100% du "jus SEO" (PageRank / Domain Authority) des backlinks
  # pointant vers http:// ou https://www.jmfmobilityservices.com est unifié.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.jmfmobilityservices\.com$ [NC]
  RewriteRule ^(.*)$ https://jmfmobilityservices.com/$1 [L,R=301]

  # 2. Servir directement les fichiers statiques existants (images, kit-backlinks.html, sitemap.xml, robots.txt)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Routage React SPA : rediriger toutes les routes vers index.html sans erreur 404
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ============================================================================
# Type MIME officiel pour le téléchargement direct des fichiers Android APK
# ============================================================================
AddType application/vnd.android.package-archive .apk

# ============================================================================
# En-têtes de sécurité et SEO (Confiance domaine & Core Web Vitals)
# ============================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1"
</IfModule>

# ============================================================================
# Cache navigateur haute performance (Score Google PageSpeed / SEO)
# ============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ============================================================================
# Compression GZIP / Deflate sur Asura Hosting
# ============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
